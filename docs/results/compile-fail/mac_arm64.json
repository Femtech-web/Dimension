    {
      "id": "compile_fail/add_collateral_to_debt",
      "kind": "compile_fail",
      "layer": "compile-time",
      "mechanism": "Adding a debt value to a collateral value, which hides the shortfall a solvency check must see",
      "ok": true,
      "problems": [],
      "observed": {
        "error_code": "8-0000",
        "message": "type mismatch",
        "diagnostics_sha256": "3a89330ad91751cfca961486edc084ddcc453556f35ba01d839c8eeac0cd3e5e",
        "twin": {
          "mode": "test",
          "fix": [
            "-use dimension::{Collateral, Debt, Value}",
            "+use dimension::{Amount, Collateral, Debt, Price, Value, covers, value_of}",
            "+use dimension::value::testing::assume_price",
            "-pub fn net(_ c: Value<USD, Collateral>, _ d: Value<USD, Debt>) -> Value<USD, Collateral> {",
            "-    c + d",
            "+// The fix: compare the two sides instead of netting them.",
            "+pub fn solvent(_ c: Value<USD, Collateral>, _ d: Value<USD, Debt>) -> bool {",
            "+    covers(c, d)"
          ],
          "passed": 1,
          "ok": true
        }
      }
    },
    {
      "id": "compile_fail/balancer_floor_upscale_as_admitted",
      "kind": "compile_fail",
      "layer": "compile-time",
      "mechanism": "An amount leaving the pool is scaled with floor rounding and handed to the math as if it had been admitted",
      "incident": "Balancer V2, 2025-11-03, about 95M to 128M USD",
      "ok": true,
      "problems": [],
      "observed": {
        "error_code": "8-0000",
        "message": "type mismatch",
        "diagnostics_sha256": "b4fda24080b70c71ce5088228a45aea1a7b9fd55918de6e313027a9e5ff06622",
        "twin": {
          "mode": "test",
          "fix": [
            "-use dimension::{Admitted, Out, Quantity, ScalingFactor, WAD, owed}",
            "-use core::num::mul_div",
            "+use dimension::{Admitted, Out, Quantity, ScalingFactor, admit, given}",
            "-// Balancer V2's _upscale: always mulDown, whichever way the amount moves.",
            "+// The fix: admit the amount leaving the pool; its direction picks the rounding.",
            "-    calc_in_given_out(owed<WSTETH, Out>(mul_div(raw, factor.value(), WAD)))",
            "+    calc_in_given_out(admit(given<WSTETH, Out>(raw), factor))"
          ],
          "passed": 1,
          "ok": true
        }
      }
    },
