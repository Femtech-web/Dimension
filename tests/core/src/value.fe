use dimension::{Amount, Collateral, Debt, Price, Value, WAD, covers, value_of}
use dimension::value::testing::assume_price
use super::assets::{CBETH, ETH, USD, USDC}

#[test]
fn composite_price_through_the_middle_asset() {
    let cbeth_eth: Price<CBETH, ETH> = unsafe {
        assume_price(1_120_000_000_000_000_000)
    }
    let eth_usd: Price<ETH, USD> = unsafe {
        assume_price(2_000 * WAD)
    }
    let cbeth_usd: Price<CBETH, USD> = cbeth_eth * eth_usd
    assert(cbeth_usd.wad() == 2_240 * WAD)
}

#[test]
fn collateral_rounds_down_and_debt_rounds_up() {
    // 1 micro-USDC at 1/3 USD: 0.333... of a 10^-6 USD unit either way.
    let third: Price<USDC, USD> = unsafe {
        assume_price(333_333_333_333_333_333)
    }
    let one = Amount<USDC>::new(1)
    let collateral: Value<USD, Collateral> = value_of(one, third)
    let debt: Value<USD, Debt> = value_of(one, third)
    assert(collateral.wad() == 333_333_333_333)
    assert(debt.wad() == 333_333_333_334)
    assert(!covers(collateral, debt))
}

#[test]
fn values_on_one_side_add() {
    let p: Price<ETH, USD> = unsafe {
        assume_price(2_000 * WAD)
    }
    let a: Value<USD, Collateral> = value_of(Amount<ETH>::new(WAD), p)
    let b: Value<USD, Collateral> = value_of(Amount<ETH>::new(WAD / 2), p)
    assert((a + b).wad() == 3_000 * WAD)
}
