use dimension::{In, Out, given, held, owed, scaling_factor, settle, supply_of}
use super::assets::USDC

#[test]
fn value_arriving_is_credited_and_value_leaving_debited() {
    let balance = held<USDC>(100).credit(given<USDC, In>(40))
    assert(balance.raw() == 140)
    // 15.5 micro-USDC owed out is paid as 15, and 15 leaves the balance.
    let paid = settle(
        owed<USDC, Out>(15_500_000_000_000),
        scaling_factor<USDC>(),
    )
    assert(balance.debit(paid).raw() == 125)
}

#[test]
fn shares_going_out_are_issued_and_shares_coming_back_retired() {
    assert(
        supply_of<USDC>(1_000).issue(given<USDC, Out>(10)).raw() == 1_010,
    )
    assert(
        supply_of<USDC>(1_000).retire(given<USDC, In>(10)).raw() == 990,
    )
}

#[test(should_revert)]
fn debiting_more_than_is_held_reverts() {
    held<USDC>(5).debit(given<USDC, Out>(6))
}
