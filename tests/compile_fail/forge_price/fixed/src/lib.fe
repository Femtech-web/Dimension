use dimension::Asset
pub struct USD {}
pub struct ETH {}
pub struct CBETH {}
pub struct WSTETH {}
pub struct USDC {}
impl Asset for USD {
    const DECIMALS: u256 = 8
}
impl Asset for ETH {
    const DECIMALS: u256 = 18
}
impl Asset for CBETH {
    const DECIMALS: u256 = 18
}
impl Asset for WSTETH {
    const DECIMALS: u256 = 18
}
impl Asset for USDC {
    const DECIMALS: u256 = 6
}
use std::evm::{Call, Ctx}
use dimension::Price
use dimension::value::oracle::{Feed, read}

// The fix: a price comes from a declared feed, through the verified boundary.
pub fn verified(_ f: Feed<CBETH, USD>) -> Price<CBETH, USD>
uses (call: mut Call, ctx: Ctx)
{
    read(f)
}
