use dimension::{In, given, held, supply_of}
use vault::vault::Vault
use super::deposit

pub struct USDC {}

#[test]
fn the_deposit_is_credited_and_its_shares_round_down() {
    // 10 assets into 100 assets and 99 shares: 10 * 100 / 101 = 9.9 shares.
    var v = Vault<USDC> { total_assets: held(100), total_shares: supply_of(99) }
    assert(deposit(mut v, given<USDC, In>(10)).value() == 9)
    assert(v.total_assets.raw() == 110)
    assert(v.total_shares.raw() == 108)
}
