use dimension::{Given, In, Out, Quantity, Settled, exchange}
use vault::vault::{Shares, Vault}

// The deposit labelled as what it is, assets arriving: its shares round down,
// and crediting it to the vault's assets compiles.
pub fn deposit<A>(_ v: mut Vault<A>, _ assets: Quantity<A, In, Given>) -> Quantity<
    Shares<A>,
    Out,
    Settled,
> {
    let shares: Quantity<Shares<A>, Out, Settled> = exchange(
        assets,
        numerator: v.total_shares.raw() + 1,
        denominator: v.total_assets.raw() + 1,
    )
    v.total_assets = v.total_assets.credit(assets)
    v.total_shares = v.total_shares.issue(shares)
    shares
}
