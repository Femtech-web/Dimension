use dimension::Asset
pub struct USD {}
pub struct ETH {}
pub struct CBETH {}
pub struct WSTETH {}
pub struct USDC {}
impl Asset for USD {
    const DECIMALS: u256 = 8
}
impl Asset for ETH {
    const DECIMALS: u256 = 18
}
impl Asset for CBETH {
    const DECIMALS: u256 = 18
}
impl Asset for WSTETH {
    const DECIMALS: u256 = 18
}
impl Asset for USDC {
    const DECIMALS: u256 = 6
}
use dimension::{Amount, Collateral, Debt, Price, Value, covers, value_of}
use dimension::value::testing::assume_price

// The fix: compare the two sides instead of netting them.
pub fn solvent(_ c: Value<USD, Collateral>, _ d: Value<USD, Debt>) -> bool {
    covers(c, d)
}
