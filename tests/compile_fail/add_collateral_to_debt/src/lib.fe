use dimension::Asset
pub struct USD {}
pub struct ETH {}
pub struct CBETH {}
pub struct WSTETH {}
pub struct USDC {}
impl Asset for USD {
    const DECIMALS: u256 = 8
}
impl Asset for ETH {
    const DECIMALS: u256 = 18
}
impl Asset for CBETH {
    const DECIMALS: u256 = 18
}
impl Asset for WSTETH {
    const DECIMALS: u256 = 18
}
impl Asset for USDC {
    const DECIMALS: u256 = 6
}
use dimension::{Collateral, Debt, Value}

pub fn net(_ c: Value<USD, Collateral>, _ d: Value<USD, Debt>) -> Value<USD, Collateral> {
    c + d
}
