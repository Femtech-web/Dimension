use dimension::Asset
pub struct USD {}
pub struct ETH {}
pub struct CBETH {}
pub struct WSTETH {}
pub struct USDC {}
impl Asset for USD {
    const DECIMALS: u256 = 8
}
impl Asset for ETH {
    const DECIMALS: u256 = 18
}
impl Asset for CBETH {
    const DECIMALS: u256 = 18
}
impl Asset for WSTETH {
    const DECIMALS: u256 = 18
}
impl Asset for USDC {
    const DECIMALS: u256 = 6
}
use dimension::value::oracle::{Feed, feed}

// The registry declares each feed once, with the pair it prices.
const CBETH_ETH: Feed<CBETH, ETH> = feed(
    Address::new(0x1),
    decimals: 18,
    max_age: 86_400,
    min_wad: 500_000_000_000_000_000,
    max_wad: 2_000_000_000_000_000_000,
)

const ETH_USD: Feed<ETH, USD> = feed(
    Address::new(0x2),
    decimals: 8,
    max_age: 3_600,
    min_wad: 100_000_000_000_000_000_000,
    max_wad: 100_000_000_000_000_000_000_000,
)

pub struct Market<T> { pub usd_feed: Feed<T, USD> }

// MIP-X43 activated the cbETH/ETH exchange-rate feed for the cbETH market.
const CBETH_MARKET: Market<CBETH> = Market { usd_feed: CBETH_ETH }
