use dimension::Asset
pub struct USD {}
pub struct ETH {}
pub struct CBETH {}
pub struct WSTETH {}
pub struct USDC {}
impl Asset for USD {
    const DECIMALS: u256 = 8
}
impl Asset for ETH {
    const DECIMALS: u256 = 18
}
impl Asset for CBETH {
    const DECIMALS: u256 = 18
}
impl Asset for WSTETH {
    const DECIMALS: u256 = 18
}
impl Asset for USDC {
    const DECIMALS: u256 = 6
}
use dimension::{Collateral, Debt, RiskPolicy, Value, is_healthy}

pub struct Generous {}
impl RiskPolicy for Generous {
    const LTV_BPS: u256 = 9_000
    const LIQUIDATION_THRESHOLD_BPS: u256 = 9_500
    const LIQUIDATION_BONUS_BPS: u256 = 500
}

pub fn healthy(_ c: Value<USD, Collateral>, _ d: Value<USD, Debt>) -> bool {
    is_healthy<USD, Generous>(c, d)
}
