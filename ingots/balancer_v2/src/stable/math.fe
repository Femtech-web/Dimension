//! Balancer V2 `Math` (pkg/solidity-utils/contracts/math/Math.sol): integer,
//! not fixed-point, operations. Same wrapping and `BAL#` reasons as `fixed_point`.

#![arithmetic(unchecked)]

pub fn mul(_ a: u256, _ b: u256) -> u256 {
    let c = a * b
    assert!(a == 0 || c / a == b, "BAL#003")
    c
}

pub fn div_down(_ a: u256, _ b: u256) -> u256 {
    assert!(b != 0, "BAL#004")
    a / b
}

pub fn div_up(_ a: u256, _ b: u256) -> u256 {
    assert!(b != 0, "BAL#004")
    if a == 0 { 0 } else { 1 + (a - 1) / b }
}
