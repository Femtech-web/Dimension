//! Balancer V2 `FixedPoint` (pkg/solidity-utils/contracts/math/FixedPoint.sol).
//!
//! Arithmetic wraps, as in Solidity 0.7, except where Balancer checks. A failed
//! check goes to the `Check` effect, which on the EVM reverts with Balancer's
//! own `BAL#` reason. `powDown`/`powUp` are not ported: StableMath does not use
//! them.

#![arithmetic(unchecked)]

use super::check::{Check, Failure}

pub const ONE: u256 = 1_000_000_000_000_000_000

pub fn add(_ a: u256, _ b: u256) -> u256 uses (check: mut Check) {
    let c = a + b
    if c < a {
        check.fail(Failure::AddOverflow)
        return 0
    }
    c
}

pub fn sub(_ a: u256, _ b: u256) -> u256 uses (check: mut Check) {
    if b > a {
        check.fail(Failure::SubOverflow)
        return 0
    }
    a - b
}

pub fn mul_down(_ a: u256, _ b: u256) -> u256 uses (check: mut Check) {
    let product = a * b
    if a != 0 && product / a != b {
        check.fail(Failure::MulOverflow)
        return 0
    }
    product / ONE
}

pub fn mul_up(_ a: u256, _ b: u256) -> u256 uses (check: mut Check) {
    let product = a * b
    if a != 0 && product / a != b {
        check.fail(Failure::MulOverflow)
        return 0
    }
    if product == 0 {
        0
    } else {
        (product - 1) / ONE + 1
    }
}

pub fn div_down(_ a: u256, _ b: u256) -> u256 uses (check: mut Check) {
    if b == 0 {
        check.fail(Failure::ZeroDivision)
        return 0
    }
    let inflated = a * ONE
    if a != 0 && inflated / a != ONE {
        check.fail(Failure::DivInternal)
        return 0
    }
    inflated / b
}

pub fn div_up(_ a: u256, _ b: u256) -> u256 uses (check: mut Check) {
    if b == 0 {
        check.fail(Failure::ZeroDivision)
        return 0
    }
    let inflated = a * ONE
    if a != 0 && inflated / a != ONE {
        check.fail(Failure::DivInternal)
        return 0
    }
    if inflated == 0 {
        0
    } else {
        (inflated - 1) / b + 1
    }
}

/// `1 - x`, or 0 when `x` exceeds 1.
pub fn complement(_ x: u256) -> u256 {
    if x < ONE { ONE - x } else { 0 }
}
