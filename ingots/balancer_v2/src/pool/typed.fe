// SPDX-License-Identifier: GPL-3.0-or-later
//! The same pool operations with their amounts typed by Dimension. Each given
//! amount enters through `admit` and each result leaves through `settle`, so
//! the rounding follows the direction the value moves instead of being chosen
//! per call. Against `faithful`, this changes exactly the two places Balancer V2
//! rounded an outgoing amount down: `swap_given_out` and `exit_given_out`.
//! Everything else, including the StableMath calls, is identical. Those calls
//! go through `math`, whose signatures take admitted amounts and return owed
//! ones, so the kernel cannot hand the math an amount that skipped `admit`.
//!
//! Joins and exits pay protocol fees exactly as in `faithful`.
//!
//! With `guard`, each operation also enforces Dimension's runtime share-value
//! check (see `pool::guarded`). It reuses the invariant the operation already
//! computes for the state before. On joins and exits it takes the invariant of
//! the balances the Vault actually holds, in place of the one Balancer derives
//! from its internal balances, both to store and to compute the protocol fee,
//! so the guard costs one extra solve on swaps only.

#![arithmetic(unchecked)]

use dimension::{
    Asset,
    Backing,
    Given,
    In,
    Out,
    Quantity,
    ScalingFactor,
    Settled,
    admit,
    preserves_share_value,
    scaling_factor,
    settle,
}
use super::Pool
use super::faithful::upscaled
use super::fees
use super::super::stable::fixed_point as fp
use super::super::stable::check::{Check, Failure}
use self::math::invariant

/// The pool's own token.
pub struct Bpt {}

impl Asset for Bpt {
    const DECIMALS: u256 = 18
}

/// A typed amount names its token by type and the pool by index; the factor
/// passed for it must be the one the pool holds at that index.
fn check_factor<T, const N: usize>(_ pool: Pool<N>, index: usize, factor: ScalingFactor<T>)
uses (check: mut Check)
{
    assert!(
        factor.value() == pool.factors[index],
        "factor does not match the token at this index",
    )
}

/// The invariant of the balances the pool actually holds.
fn held<const N: usize>(_ pool: Pool<N>) -> u256
uses (check: mut Check) where N >= 2, N <= 5
{
    invariant(pool.amp, upscaled(pool.balances, pool.factors))
}

/// Fails the operation if the value behind each BPT fell.
fn enforce<const N: usize>(_ pool: Pool<N>, before: Backing, after_value: u256)
uses (check: mut Check)
{
    if !preserves_share_value(
        before,
        Backing { value: after_value, shares: pool.supply },
    ) {
        check.fail(Failure::ShareValueDecreased)
    }
}

/// Ends a join or exit: pays the protocol's fee on it and stores the invariant
/// after it, `before` holding the invariant and supply it started from. With
/// `guard`, that invariant is of the balances the pool actually holds, and the
/// value behind each BPT must not have fallen.
fn finish_join_exit<const N: usize>(
    _ pool: mut Pool<N>,
    balances: [u256; N],
    before: Backing,
    guard: bool,
)
uses (check: mut Check)
where N >= 2, N <= 5
{
    let post_invariant = if guard {
        held(pool)
    } else {
        invariant(pool.amp, balances)
    }
    fees::update_after_join_exit(
        mut pool,
        post_invariant,
        pre_invariant: before.value,
        pre_supply: before.shares,
    )
    if guard {
        enforce(pool, before, after_value: post_invariant)
    }
}

pub fn swap_given_in<TIn, TOut, const N: usize>(
    _ pool: mut Pool<N>,
    i: usize,
    j: usize,
    amount_in: Quantity<TIn, In, Given>,
    factor_in: ScalingFactor<TIn>,
    factor_out: ScalingFactor<TOut>,
    guard: bool,
) -> Quantity<TOut, Out, Settled>
uses (check: mut Check)
where N >= 2, N <= 5
{
    check_factor(pool, index: i, factor: factor_in)
    check_factor(pool, index: j, factor: factor_out)
    let raw_in = amount_in.value()
    let after_fee = dimension::given<TIn, In>(fp::sub(raw_in, fp::mul_up(raw_in, pool.fee)))
    let balances = upscaled(pool.balances, pool.factors)
    let pre_invariant = invariant(pool.amp, balances)
    let before = Backing { value: pre_invariant, shares: pool.supply }
    let out = math::out_given_in(
        pool,
        balances,
        index_in: i,
        index_out: j,
        amount_in: admit(after_fee, factor_in),
        invariant: pre_invariant,
    )
    let amount_out = settle(out, factor_out)
    pool.balances[i] = fp::add(pool.balances[i], raw_in)
    pool.balances[j] = fp::sub(pool.balances[j], amount_out.value())
    if guard {
        enforce(pool, before, after_value: held(pool))
    }
    amount_out
}

pub fn swap_given_out<TIn, TOut, const N: usize>(
    _ pool: mut Pool<N>,
    i: usize,
    j: usize,
    amount_out: Quantity<TOut, Out, Given>,
    factor_in: ScalingFactor<TIn>,
    factor_out: ScalingFactor<TOut>,
    guard: bool,
) -> Quantity<TIn, In, Settled>
uses (check: mut Check)
where N >= 2, N <= 5
{
    check_factor(pool, index: i, factor: factor_in)
    check_factor(pool, index: j, factor: factor_out)
    let balances = upscaled(pool.balances, pool.factors)
    let pre_invariant = invariant(pool.amp, balances)
    let before = Backing { value: pre_invariant, shares: pool.supply }
    let scaled_in = math::in_given_out(
        pool,
        balances,
        index_in: i,
        index_out: j,
        amount_out: admit(amount_out, factor_out),
        invariant: pre_invariant,
    )
    let amount_in = settle(scaled_in, factor_in)
        .scaled_by(numerator: fp::ONE, denominator: fp::complement(pool.fee))
    pool.balances[i] = fp::add(pool.balances[i], amount_in.value())
    pool.balances[j] = fp::sub(pool.balances[j], amount_out.value())
    if guard {
        enforce(pool, before, after_value: held(pool))
    }
    amount_in
}

pub fn exit_given_out<T, const N: usize>(
    _ pool: mut Pool<N>,
    j: usize,
    amount_out: Quantity<T, Out, Given>,
    factor: ScalingFactor<T>,
    guard: bool,
) -> Quantity<Bpt, In, Settled>
uses (check: mut Check)
where N >= 2, N <= 5
{
    check_factor(pool, index: j, factor)
    var balances = upscaled(pool.balances, pool.factors)
    let scaled_out = admit(amount_out, factor)
    let pre_invariant = invariant(pool.amp, balances)
    fees::pay_before_join_exit(mut pool, invariant: pre_invariant)
    let before = Backing { value: pre_invariant, shares: pool.supply }
    let bpt_in = math::bpt_in_given_exact_token_out(
        pool,
        balances,
        index: j,
        amount_out: scaled_out,
        invariant: pre_invariant,
    )
    balances[j] = fp::sub(balances[j], scaled_out.value())
    pool.supply = fp::sub(before.shares, bpt_in.value())
    pool.balances[j] = fp::sub(pool.balances[j], amount_out.value())
    finish_join_exit(mut pool, balances, before, guard)
    settle(bpt_in, scaling_factor<Bpt>())
}

pub fn exit_given_in<T, const N: usize>(
    _ pool: mut Pool<N>,
    j: usize,
    bpt_in: Quantity<Bpt, In, Given>,
    factor: ScalingFactor<T>,
    guard: bool,
) -> Quantity<T, Out, Settled>
uses (check: mut Check)
where N >= 2, N <= 5
{
    check_factor(pool, index: j, factor)
    var balances = upscaled(pool.balances, pool.factors)
    let pre_invariant = invariant(pool.amp, balances)
    fees::pay_before_join_exit(mut pool, invariant: pre_invariant)
    let before = Backing { value: pre_invariant, shares: pool.supply }
    let scaled_out = math::token_out_given_exact_bpt_in(
        pool,
        balances,
        index: j,
        bpt_in: admit(bpt_in, scaling_factor<Bpt>()),
        invariant: pre_invariant,
    )
    balances[j] = fp::sub(balances[j], scaled_out.value())
    pool.supply = fp::sub(before.shares, bpt_in.value())
    let amount_out = settle(scaled_out, factor)
    pool.balances[j] = fp::sub(pool.balances[j], amount_out.value())
    finish_join_exit(mut pool, balances, before, guard)
    amount_out
}

pub fn join_given_in<T, const N: usize>(
    _ pool: mut Pool<N>,
    i: usize,
    amount_in: Quantity<T, In, Given>,
    factor: ScalingFactor<T>,
    guard: bool,
) -> Quantity<Bpt, Out, Settled>
uses (check: mut Check)
where N >= 2, N <= 5
{
    check_factor(pool, index: i, factor)
    var balances = upscaled(pool.balances, pool.factors)
    let scaled_in = admit(amount_in, factor)
    let pre_invariant = invariant(pool.amp, balances)
    fees::pay_before_join_exit(mut pool, invariant: pre_invariant)
    let before = Backing { value: pre_invariant, shares: pool.supply }
    let bpt_out = math::bpt_out_given_exact_token_in(
        pool,
        balances,
        index: i,
        amount_in: scaled_in,
        invariant: pre_invariant,
    )
    balances[i] = fp::add(balances[i], scaled_in.value())
    pool.supply = fp::add(before.shares, bpt_out.value())
    pool.balances[i] = fp::add(pool.balances[i], amount_in.value())
    finish_join_exit(mut pool, balances, before, guard)
    settle(bpt_out, scaling_factor<Bpt>())
}

pub fn join_given_out<T, const N: usize>(
    _ pool: mut Pool<N>,
    i: usize,
    bpt_out: Quantity<Bpt, Out, Given>,
    factor: ScalingFactor<T>,
    guard: bool,
) -> Quantity<T, In, Settled>
uses (check: mut Check)
where N >= 2, N <= 5
{
    check_factor(pool, index: i, factor)
    var balances = upscaled(pool.balances, pool.factors)
    let pre_invariant = invariant(pool.amp, balances)
    fees::pay_before_join_exit(mut pool, invariant: pre_invariant)
    let before = Backing { value: pre_invariant, shares: pool.supply }
    let scaled_in = math::token_in_given_exact_bpt_out(
        pool,
        balances,
        index: i,
        bpt_out: admit(bpt_out, scaling_factor<Bpt>()),
        invariant: pre_invariant,
    )
    balances[i] = fp::add(balances[i], scaled_in.value())
    pool.supply = fp::add(before.shares, bpt_out.value())
    let amount_in = settle(scaled_in, factor)
    pool.balances[i] = fp::add(pool.balances[i], amount_in.value())
    finish_join_exit(mut pool, balances, before, guard)
    amount_in
}
