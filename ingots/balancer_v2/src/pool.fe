//! A Balancer V2 composable stable pool, reduced to the state its swaps and
//! single-token joins and exits read and write.
//!
//! What is kept, operation for operation: fee handling, scaling of balances and
//! amounts, the StableMath calls, the invariant stored after joins and exits,
//! the Vault's balance and BPT supply updates, and the protocol fees minted on
//! joins and exits. What is left out: amplification changes, rate changes
//! between joins and exits, recovery mode and pausing. Two kernels share this
//! state: `faithful` rounds as Balancer V2 does, `typed` brings amounts in and
//! out through Dimension.

/// Pool state as the Vault and the pool hold it. Token balances are raw, in each
/// token's smallest unit; BPT is tracked as the virtual supply.
pub struct Pool<const N: usize> {
    pub balances: [u256; N],
    /// Decimal scaling times rate, rounded down, as `_scalingFactors()` returns.
    pub factors: [u256; N],
    pub supply: u256,
    pub amp: u256,
    pub fee: u256,
    /// The invariant stored after the last join or exit.
    pub stored_invariant: u256,
    /// The protocol's share of swap fees, minted as BPT on joins and exits.
    pub protocol_swap_fee: u256,
}

impl<const N: usize> Copy for Pool<N> {}
