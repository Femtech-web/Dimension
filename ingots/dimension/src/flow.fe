//! What a quantity means to the protocol, and therefore how it must round.
//!
//! Every rounding direction in Dimension follows from one rule: a rounding
//! error must never move value from the protocol to whoever triggered it.

use super::rounding::{Ceil, Floor, Rounding}

/// Named only in this module. Fe 26.6 does not check a private trait's
/// visibility where it is implemented (argotorg/fe#2036), but does check a
/// struct's, so no implementation of `Sealed` can be written elsewhere.
struct Key {}

trait Sealed {
    fn key(_ k: Key)
}

/// The direction value moves, seen from the protocol.
pub trait Flow: Sealed {
    /// Rounding for bringing a given amount into internal accounting.
    type Admission: Rounding
    /// Rounding for turning an internal result into an amount to transfer.
    type Obligation: Rounding
    /// The direction of what the protocol gives in exchange for value moving
    /// this way: an amount coming in is paid for by one going out.
    type Opposite: Flow
}

/// Value the protocol receives. Count less than arrives; charge at least
/// what is owed.
pub struct In {}

/// Value the protocol pays out. Count at least what leaves; pay no more
/// than what is owed.
pub struct Out {}

impl Sealed for In {
    fn key(_ k: Key) {}
}
impl Sealed for Out {
    fn key(_ k: Key) {}
}

impl Flow for In {
    type Admission = Floor
    type Obligation = Ceil
    type Opposite = Out
}

impl Flow for Out {
    type Admission = Ceil
    type Obligation = Floor
    type Opposite = In
}

/// Where a flow quantity is in its life. Each stage is reachable only through
/// the operation that rounds correctly into it.
pub trait Stage: Sealed {}

/// A raw amount named by the caller, as received at an entry point.
pub struct Given {}
/// A given amount in internal 18-decimal units, rounded by `Flow::Admission`.
pub struct Admitted {}
/// An internal result the protocol's math computed.
pub struct Owed {}
/// A raw amount to transfer, rounded by `Flow::Obligation`.
pub struct Settled {}

impl Sealed for Given {
    fn key(_ k: Key) {}
}
impl Sealed for Admitted {
    fn key(_ k: Key) {}
}
impl Sealed for Owed {
    fn key(_ k: Key) {}
}
impl Sealed for Settled {
    fn key(_ k: Key) {}
}

impl Stage for Given {}
impl Stage for Admitted {}
impl Stage for Owed {}
impl Stage for Settled {}

/// The stages whose amount is in the token's own units, as transferred:
/// `Given` and `Settled`. `Admitted` and `Owed` are internal 18-decimal units,
/// which never belong in a raw balance.
pub trait TokenUnits: Stage {}

impl TokenUnits for Given {}
impl TokenUnits for Settled {}

/// Which side of a solvency check a value is counted on.
pub trait Valuation: Sealed {
    type Rounding: Rounding
}

/// Value backing a position. Rounded down so collateral is never overstated.
pub struct Collateral {}

/// Value a position owes. Rounded up so debt is never understated.
pub struct Debt {}

impl Sealed for Collateral {
    fn key(_ k: Key) {}
}
impl Sealed for Debt {
    fn key(_ k: Key) {}
}

impl Valuation for Collateral {
    type Rounding = Floor
}

impl Valuation for Debt {
    type Rounding = Ceil
}
