use dimension::{Given, Held, In, Out, Quantity, Settled, Supply, exchange}

/// The share token of a vault over `A`.
pub struct Shares<A> {}

/// What a vault over `A` holds and has issued: its assets are a balance of `A`
/// it holds, its shares a supply it issues, so each moves only in the direction
/// an amount is labelled, and only by an amount of its own token. Conversions
/// count one virtual asset and one virtual share, as OpenZeppelin's ERC4626 does
/// with a decimals offset of 0, so a first depositor cannot inflate the share
/// price to nothing.
pub struct Vault<A> { pub total_assets: Held<A>, pub total_shares: Supply<Shares<A>> }

impl<A> Copy for Vault<A> {}

/// Shares for depositing `assets`: assets come in, shares go out.
pub fn preview_deposit<A>(_ v: Vault<A>, _ assets: Quantity<A, In, Given>) -> Quantity<
    Shares<A>,
    Out,
    Settled,
> {
    exchange(
        assets,
        numerator: v.total_shares.raw() + 1,
        denominator: v.total_assets.raw() + 1,
    )
}

/// Assets that minting `shares` costs: shares go out, assets come in.
pub fn preview_mint<A>(_ v: Vault<A>, _ shares: Quantity<Shares<A>, Out, Given>) -> Quantity<
    A,
    In,
    Settled,
> {
    exchange(
        shares,
        numerator: v.total_assets.raw() + 1,
        denominator: v.total_shares.raw() + 1,
    )
}

/// Shares that withdrawing `assets` burns: assets go out, shares come in.
pub fn preview_withdraw<A>(_ v: Vault<A>, _ assets: Quantity<A, Out, Given>) -> Quantity<
    Shares<A>,
    In,
    Settled,
> {
    exchange(
        assets,
        numerator: v.total_shares.raw() + 1,
        denominator: v.total_assets.raw() + 1,
    )
}

/// Assets for redeeming `shares`: shares come in, assets go out.
pub fn preview_redeem<A>(_ v: Vault<A>, _ shares: Quantity<Shares<A>, In, Given>) -> Quantity<
    A,
    Out,
    Settled,
> {
    exchange(
        shares,
        numerator: v.total_assets.raw() + 1,
        denominator: v.total_shares.raw() + 1,
    )
}

pub fn deposit<A>(_ v: mut Vault<A>, _ assets: Quantity<A, In, Given>) -> Quantity<
    Shares<A>,
    Out,
    Settled,
> {
    let shares = preview_deposit(v, assets)
    v.total_assets = v.total_assets.credit(assets)
    v.total_shares = v.total_shares.issue(shares)
    shares
}

pub fn mint<A>(_ v: mut Vault<A>, _ shares: Quantity<Shares<A>, Out, Given>) -> Quantity<
    A,
    In,
    Settled,
> {
    let assets = preview_mint(v, shares)
    v.total_assets = v.total_assets.credit(assets)
    v.total_shares = v.total_shares.issue(shares)
    assets
}

pub fn withdraw<A>(_ v: mut Vault<A>, _ assets: Quantity<A, Out, Given>) -> Quantity<
    Shares<A>,
    In,
    Settled,
> {
    let shares = preview_withdraw(v, assets)
    v.total_assets = v.total_assets.debit(assets)
    v.total_shares = v.total_shares.retire(shares)
    shares
}

pub fn redeem<A>(_ v: mut Vault<A>, _ shares: Quantity<Shares<A>, In, Given>) -> Quantity<
    A,
    Out,
    Settled,
> {
    let assets = preview_redeem(v, shares)
    v.total_assets = v.total_assets.debit(assets)
    v.total_shares = v.total_shares.retire(shares)
    assets
}
